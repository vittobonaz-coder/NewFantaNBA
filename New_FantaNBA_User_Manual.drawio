x;&quot;&gt;+ fetch_boxscores(date_string)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ download_all_players()&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ fetch_players_info(player_ids, filename)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ get_players_ids_by_name(player_names_list)&lt;/p&gt;" vertex="1">
