# Modello del file .env per cron e script di amministrazione in locale (swap_players.py, setup, reset...).
# Copialo in .env (già in .gitignore, non va MAI committato) e incolla la chiave segreta di Supabase:
# Project Settings > API Keys > Secret keys (sb_secret_...).
# Non serve all'app né a Render: l'app usa solo la chiave pubblicabile, scritta in supabase_rest.py.
SUPABASE_SECRET_KEY=

# Facoltativo (Fase 5): firma degli APK compilati sul PC con la chiave vera (tools/build_apk.ps1).
# Il keystore resta fuori dalla repository; password scelta alla creazione (docs/fase5_piano.md, sez. 2).
# ANDROID_KEYSTORE_PATH=C:\Users\<utente>\.bonkest\bonkest-release.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=bonkest
# ANDROID_CERT_SHA256=
